# ─────────────────────────────────────────────────────────────────────────────
# C786 Realty — Trussardi Residences landing page
# Copy to `.env` (or set in your host's dashboard) and fill in before launch.
#
# Everything here is compiled into the CLIENT bundle. Never put an API key,
# access token or password in this file — a lead endpoint must be safe to expose,
# with any secret held server-side by the receiving service.
# ─────────────────────────────────────────────────────────────────────────────

# Production origin, no trailing slash.
# Drives the canonical URL, Open Graph URL and the absolute social image.
VITE_SITE_URL=https://www.example.com

# Where the lead form delivers.
#
# Leave EMPTY and the form will not claim success — it hands the completed
# answers to WhatsApp instead, so no enquiry is silently lost.
#
# Accepts either:
#   • A Google Form response URL, e.g.
#     https://docs.google.com/forms/d/e/<FORM_ID>/formResponse
#     (posted form-encoded and no-cors; verify receipt in the responses sheet)
#   • Any endpoint accepting a JSON POST — Formspree, Make, n8n, or your own
#     serverless function. It must return a 2xx on success.
VITE_LEAD_ENDPOINT=
